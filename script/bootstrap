#!/usr/bin/env bash
#
# bootstrap installs things.

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e

echo ''

info () {
  printf "\r  [ \033[00;34m..\033[0m ] %s\n" "$1"
}

user () {
  printf "\r  [ \033[0;33m??\033[0m ] %s\n" "$1"
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n" "$1"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] %s\n" "$1"
  echo ''
  exit
}

# Update the dotfiles before anything else runs, and restart if HEAD moved.
#
# Two traps this replaces:
#   1. bin/dot used to be the only place that pulled, and bootstrap sources it
#      half way through -- by then bash has already parsed this file's
#      functions, so the run that fetches a fix keeps executing the pre-fix
#      code (always one run too late). Rewriting a script that a live bash is
#      still reading also shifts its byte offsets, so re-exec instead of
#      carrying on with a half-read file.
#   2. `git pull` is unusable here: the gitconfig sets pull.rebase=true, which
#      aborts with "cannot pull with rebase: You have unstaged changes" -- and
#      the old `git pull || true` hid that while still printing "git pull".
#      Fetch, then fast-forward explicitly.
update_dotfiles () {
  local before upstream after

  before=$(git -C "$DOTFILES_ROOT" rev-parse HEAD 2>/dev/null) || return 0

  info 'updating dotfiles'
  if ! git -C "$DOTFILES_ROOT" fetch --quiet
  then
    info 'git fetch failed (offline, or no remote); continuing with the local copy'
    return 0
  fi

  upstream=$(git -C "$DOTFILES_ROOT" rev-parse '@{u}' 2>/dev/null)
  if [ -z "$upstream" ]
  then
    info 'no upstream branch configured; skipping update'
    return 0
  fi

  # Fast-forward only -- a merge or rebase here could rewrite history mid-run.
  if ! git -C "$DOTFILES_ROOT" merge --ff-only '@{u}'
  then
    info 'update available but cannot be fast-forwarded (local changes in the way, or diverged history); continuing with the local copy -- run git pull manually'
    return 0
  fi

  after=$(git -C "$DOTFILES_ROOT" rev-parse HEAD)
  export DOTFILES_SELF_UPDATED=1

  # Re-exec only when HEAD really moved: a local branch that is ahead of the
  # upstream also shows before != upstream, and merging it is a no-op.
  if [ "$before" != "$after" ] && [ -z "${DOTFILES_BOOTSTRAP_REEXEC:-}" ]
  then
    success 'dotfiles updated, restarting bootstrap with the new code'
    export DOTFILES_BOOTSTRAP_REEXEC=1
    exec "$0" "$@"
  fi

  if [ "$before" = "$after" ]
  then
    info 'already up to date'
  fi
}

setup_gitconfig () {
  if ! [ -f home/gitconfig.local.symlink ]
  then
    info 'setup gitconfig'

    git_credential='cache'
    if [ "$(uname -s)" == "Darwin" ]
    then
      git_credential='osxkeychain'
    fi

    user ' - What is your github author name?'
    read -e git_authorname
    user ' - What is your github author email?'
    read -e git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" home/gitconfig.local.symlink.example > home/gitconfig.local.symlink

    success 'gitconfig'
  fi
}


link_file () {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      local currentSrc="$(readlink $dst)"

      if [ "$currentSrc" == "$src" ]
      then

        skip=true;

      else

        user "File already exists: $dst ($(basename "$src")), what do you want to do?
[s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action

        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            ;;
        esac

      fi

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    success "linked $1 to $2"
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  for src in $(find -H "$DOTFILES_ROOT" -name '*.symlink' -not -path '*.git*')
  do
    local rel="${src#"$DOTFILES_ROOT"/}"

    if [[ "$rel" == home/* ]]
    then
      local home_rel="${rel#home/}"
      local top="${home_rel%%/*}"
      local rest=

      if [[ "$home_rel" == */* ]]
      then
        rest="/${home_rel#*/}"
      fi

      dst="$HOME/.${top}${rest}"
      dst="${dst%.symlink}"
      mkdir -p "$(dirname "$dst")"
    else
      dst="$HOME/.$(basename "${src%.*}")"
    fi

    link_file "$src" "$dst"
  done
}

update_dotfiles "$@"
setup_gitconfig
install_dotfiles

# If we're on a Mac, let's install and setup homebrew.
if [ "$(uname -s)" == "Darwin" ]
then
  info "installing dependencies"
  if source bin/dot | while read -r data; do info "$data"; done
  then
    success "dependencies installed"
  else
    fail "error installing dependencies"
  fi
fi

echo ''
echo '  All installed!'
