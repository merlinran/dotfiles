#!/bin/zsh
# pi with Cursor Pro subscription models
#
# Default model: auto (Cursor auto-routing).
# No --models here: Ctrl+P uses the global enabledModels list, so you can
# cycle to any configured model (deepseek, kimi, ...) mid-session.
/opt/homebrew/bin/pi \
  --provider cursor \
  --model auto \
  "$@"
