<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. llama/install.sh substitutes __HOME__ and __MODEL__ and installs
  the result to ~/Library/LaunchAgents/local.llama-server.plist.

  Single-model mode: one model, deterministic start. To swap models, change the
  --model path here and run `llama-restart` (or `script/install`).

  Slot KV save/restore lives in llama.zsh (llama-save/llama-restore, called by
  llama-stop/llama-start) rather than in a wrapper process: a wrapper that
  traps SIGTERM fights launchd's own stop handling and made llama-server abort
  in ggml-metal teardown. --slot-save-path is passed below.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.llama-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/llama-server</string>

        <string>--model</string>
        <string>__MODEL__</string>
        <string>--alias</string>
        <string>qwen3.6-35b-a3b</string>

        <!-- Apple Silicon: offload every layer, keep flash attention on -->
        <string>--n-gpu-layers</string>
        <string>999</string>
        <string>--flash-attn</string>
        <string>on</string>

        <!-- Two inference slots for the two local-model Raft agents. Raft's
             max=5 log field limits concurrent agent STARTUPS, not running
             sessions or inference requests. It is not a slot-sizing target.
             Use 3 slots if an interactive Pi client also needs concurrent
             inference. Idle slots still cost allocated KV memory.
             Keep models.json contextWindow in sync with the per-slot limit. -->
        <string>--parallel</string>
        <string>2</string>
        <string>--kv-unified</string>
        <string>--kv-unified-per-slot</string>
        <string>131072</string>

        <!-- RAM prompt cache for displaced conversations. A 128K hybrid
             prompt state can exceed 9 GiB, so the 8 GiB default cannot retain
             one. Keep 12 GiB as a cap, not a reservation; avoid increasing it
             on this 64 GiB machine without measuring memory pressure. -->
        <!-- Keep recurring conversations in their resident slots rather than
             saving/clearing every other idle slot on each new request. The KV
             pool already budgets a full context for both agents. -->
        <string>--no-cache-idle-slots</string>
        <string>--cache-ram</string>
        <string>12288</string>

        <!-- Quantized KV cache. These models use 4 KV heads (GQA), so KV is
             cheap enough to afford q8_0 rather than defaulting to f16. -->
        <string>--cache-type-k</string>
        <string>q8_0</string>
        <string>--cache-type-v</string>
        <string>q8_0</string>

        <!-- Prefill batching. Prefill dominates agent-loop latency. -->
        <string>--batch-size</string>
        <string>2048</string>
        <string>--ubatch-size</string>
        <string>512</string>

        <!-- MTP speculative decoding. No-op unless the GGUF carries the extra
             prediction heads (the -MTP-GGUF repo does). -->
        <string>--spec-type</string>
        <string>draft-mtp</string>
        <string>--spec-draft-n-max</string>
        <string>2</string>

        <!-- Slot KV save/restore (llama-save/llama-restore). State lives under
             ~/.local/state/llama/slots and is not part of the model. -->
        <string>--slot-save-path</string>
        <string>__HOME__/.local/state/llama/slots</string>

        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8080</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd does not inherit the interactive shell environment, so
             anything the server needs must be set explicitly here. -->
        <key>HF_ENDPOINT</key>
        <string>https://hf-mirror.com</string>
        <key>LLAMA_CACHE</key>
        <string>__HOME__/models</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Ask macOS not to throttle this as a background task; it is latency
         sensitive and drives the GPU. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>WorkingDirectory</key>
    <string>__HOME__</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/llama/server.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/llama/server.err.log</string>
</dict>
</plist>
