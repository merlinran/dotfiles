<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. llama/install.sh substitutes __HOME__ and __MODEL__ and installs
  the result to ~/Library/LaunchAgents/local.llama-server.plist.

  Single-model mode: one model, deterministic start. To swap models, change the
  --model path here and run `llama-restart` (or `script/install`).

  Slot KV save/restore lives in llama.zsh (llama-save/llama-restore, called by
  llama-stop/llama-start) rather than in a wrapper process: a wrapper that
  traps SIGTERM fights launchd's own stop handling and made llama-server abort
  in ggml-metal teardown. --slot-save-path is passed below.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.llama-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/llama-server</string>

        <string>--model</string>
        <string>__MODEL__</string>
        <string>--alias</string>
        <string>qwen3.6-35b-a3b</string>

        <!-- Apple Silicon: offload every layer, keep flash attention on -->
        <string>--n-gpu-layers</string>
        <string>999</string>
        <string>--flash-attn</string>
        <string>on</string>

        <!-- Concurrency. Raft runs up to 5 agents concurrently and its provider
             timeout is 60s. With a single slot they serialised: one agent's long
             generation (observed 1956 tokens at ~17.7 tok/s = 110s) exceeded the
             timeout, so every other agent failed with "Model service request
             failed (custom)". The server log showed clients giving up:
                 stop: cancel task, id_task = 39014 ...

             Five slots to match Raft's concurrent-agent limit (max=5), so
             agents queue only under genuinely heavy load. Unified KV shares one
             pool sized n_parallel * per-slot = 5 * 131072 = 655360 tokens, the
             largest KV pool here -- verify wired memory after changing it.

             Measured cost of extra slots is memory, not speed: single-stream
             decode 70.7 -> 69.4 -> 68.9 tok/s for -np 1/2/3, with MTP draft
             acceptance unchanged at 0.71698. So raise this freely until memory
             says stop; do not raise it expecting per-agent speed.

             What does degrade is simultaneous use: aggregate decode is flat
             (bandwidth-bound), so per-stream decode divides by concurrency.
             Prefill is compute-bound and batches well, so overall turn latency
             still improves. Keep models.json contextWindow in sync with the
             per-slot value below. -->
        <string>--parallel</string>
        <string>5</string>
        <string>--kv-unified</string>
        <string>--kv-unified-per-slot</string>
        <string>131072</string>

        <!-- Unified KV keeps a RAM budget for slot states that are not currently
             resident, so a conversation that waits for a slot can resume without
             re-prefilling its whole context.

             The 8192 MiB default was actively harmful here and had to be raised:
             a 128K-context prompt state measured 9.3 GB, so llama.cpp logged
             "prompt state size 9298 MiB exceeds cache size limit 8192 MiB,
             skipping" and silently dropped it, defeating multi-conversation
             reuse entirely.

             12288 (12 GB) is the smallest value that clears a single 9.3 GB
             state with headroom. Measured headroom with this config is 20.8 GB
             readily available (free + inactive + purgeable + speculative)
             against a 36.1 GB wired floor, so a 16 GB cache would leave too
             little for macOS plus Xcode/Android builds. Raise only after
             re-measuring headroom. -->
        <string>--cache-ram</string>
        <string>12288</string>

        <!-- Quantized KV cache. These models use 4 KV heads (GQA), so KV is
             cheap enough to afford q8_0 rather than defaulting to f16. -->
        <string>--cache-type-k</string>
        <string>q8_0</string>
        <string>--cache-type-v</string>
        <string>q8_0</string>

        <!-- Prefill batching. Prefill dominates agent-loop latency. -->
        <string>--batch-size</string>
        <string>2048</string>
        <string>--ubatch-size</string>
        <string>512</string>

        <!-- MTP speculative decoding. No-op unless the GGUF carries the extra
             prediction heads (the -MTP-GGUF repo does). -->
        <string>--spec-type</string>
        <string>draft-mtp</string>
        <string>--spec-draft-n-max</string>
        <string>2</string>

        <!-- Slot KV save/restore (llama-save/llama-restore). State lives under
             ~/.local/state/llama/slots and is not part of the model. -->
        <string>--slot-save-path</string>
        <string>__HOME__/.local/state/llama/slots</string>

        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8080</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd does not inherit the interactive shell environment, so
             anything the server needs must be set explicitly here. -->
        <key>HF_ENDPOINT</key>
        <string>https://hf-mirror.com</string>
        <key>LLAMA_CACHE</key>
        <string>__HOME__/models</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Ask macOS not to throttle this as a background task; it is latency
         sensitive and drives the GPU. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>WorkingDirectory</key>
    <string>__HOME__</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/llama/server.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/llama/server.err.log</string>
</dict>
</plist>
