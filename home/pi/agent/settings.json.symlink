{
  "lastChangelogVersion": "1.0.1",
  "theme": "dark",
  "extensions": [
    "-builtin:llama.cpp"
  ],
  "packages": [
    "git:github.com/merlinran/superpowers",
    "git:github.com/merlinran/pi-superagents",
    "npm:@hk_net/pi-timestamp",
    "npm:pi-web-access"
  ],
  "defaultProvider": "llama-local",
  "defaultModel": "llama-local/qwen3.6-35b-a3b",
  "enabledModels": [
    "llama-local/qwen3.6-35b-a3b",
    "qwen-pro/qwen3.8-flash",
    "qwen-pro/qwen3.8-max",
    "qwen-pro/deepseek-v4.1-flash",
    "deepseek/deepseek-flash",
    "zai/glm-5.3",
    "zai/glm-5.3-flash",
    "router/auto"
  ],
  "defaultThinkingLevel": "low",
  "hideThinkingBlock": false,
  "retry": {
    "provider": {
      "timeoutMs": 1800000
    }
  },
  "compaction": {
    "modelOverrides": {
      "router/auto": {
        "reserveTokens": 820000
      }
    }
  },
  "httpIdleTimeoutMs": 0,
  "terminal": {
    "showTerminalProgress": true
  }
}