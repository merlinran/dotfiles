/**
 * GLM / DeepSeek smart router
 *
 * Default: DeepSeek Flash. During 01:00–09:00 UTC (09:00–18:00 SGT),
 * route to GLM; otherwise DeepSeek.
 *
 * Once on GLM, stay through continuations. Compaction resets to DeepSeek.
 * GLM rate-limit → fall back to DeepSeek.
 * When the rate-limit window passes (parsed from 429 Retry-After),
 * switch back to GLM automatically on the next continuation.
 *
 * All in-memory, zero extra latency.
 */

import type {
	Message,
	ExtensionAPI,
	ExtensionContext,
	ModelRoute,
	ModelRouteRequest,
} from "@earendil-works/pi-coding-agent";

const GLM = { provider: "zai" as const, id: "glm-5.3-flash" as const };
const DS  = { provider: "deepseek" as const, id: "deepseek-flash" as const };

interface State {
	/** GLM is active — sticky through continuations */
	glm?: true;
	/** Message count for compaction detection */
	msgs?: number;
	/** Earliest time (ms) to retry GLM after rate-limit. Parsed from 429 error. */
	rlResetAt?: number;
}

/**
 * 01:00–09:00 UTC = 09:00–18:00 SGT, all days.
 * Only time DeepSeek is peak while GLM is off-peak.
 */
function useGlm(): boolean {
	const d = new Date();
	return d.getUTCHours() >= 1 && d.getUTCHours() < 10;
}

function find(ctx: ExtensionContext, p: "zai" | "deepseek", id: string) {
	const m = ctx.modelRegistry.find(p, id);
	if (!m) throw new Error(`No model: ${p}/${id}`);
	return m;
}

/**
 * Detect rate-limit / usage-limit / quota errors.
 * Covers common Zai / GLM error formats: HTTP 429, textual messages,
 * and known numeric error codes.
 */
function isRateLimit(err: string | undefined): boolean {
	if (!err) return false;
	// Normalize: remove JSON formatting chars, collapse whitespace
	const l = err.toLowerCase().replace(/[\s{}"[\]]+/g, " ");
	return l.includes("429") || l.includes("rate limit") || l.includes("quota")
		|| l.includes("usage limit") || l.includes("fair usage")
		|| l.includes("too many") || l.includes("rate exceeded")
		|| l.includes("1302") || l.includes("1305") || l.includes("1308")
		|| l.includes("1310") || l.includes("1313")
		|| l.includes("20243") || l.includes("20245");
}

/**
 * Extract the Zai rate-limit reset time from any error message.
 *
 * Every Zai 429 with a usage limit includes a datetime like:
 *   "2026-10-11 13:08:11"
 *
 * This regex works regardless of how pi wraps or formats the error message.
 * The timestamp is Zai's local time (UTC+8), not UTC: for code 1308 ("5 hour"
 * limit) the parsed delta is 8.0–12.2h if read as UTC, but 0–4.2h as UTC+8,
 * which is the only reading consistent with a 5-hour budget.
 * Falls back to 10 minutes if not found.
 */
function parseRetryAfter(err: string | undefined, now = Date.now()): number {
	if (!err) return now + 10 * 60 * 1000; // default: 10 min

	// Datetime: YYYY-MM-DD HH:MM:SS (space-separated, Zai local time, UTC+8)
	const match = err.match(/(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2}:\d{2})/);
	if (match) {
		const t = Date.parse(`${match[1]}T${match[2]}+08:00`);
		// Allow up to 8 days, so weekly limits (code 1310) are honoured.
		if (!isNaN(t) && t > now && t - now < 8 * 24 * 3600 * 1000) {
			return t;
		}
	}

	// Fallback: 10 minute cooldown
	return now + 10 * 60 * 1000;
}

/** >50% message count drop = compaction */
function compacted(msgs: readonly Message[], s: State): boolean {
	return (s.msgs !== undefined && s.msgs >= 5 && msgs.length < s.msgs * 0.5);
}

/**
 * GLM may be selected right now: inside the time window and not in a
 * rate-limit cooldown recorded by a previous 429.
 */
function glmUsable(s: State): boolean {
	if (!useGlm()) return false;
	return s.rlResetAt === undefined || Date.now() >= s.rlResetAt;
}

export default function (pi: ExtensionAPI) {
	// Register under a custom provider ID that is always available
	// (not tied to a real provider with credentials).
	pi.registerVirtualModel<State>({
		provider: "deepseek-glm",
		id: "on-peak",
		name: "DeepSeek (+ GLM 09–18 SGT)",
		thinkingLevels: ["low", "medium", "high", "xhigh"],
		contextWindow: 1_048_576,
		maxTokens: 384_000,

		route(r: ModelRouteRequest<State>, ctx: ExtensionContext): ModelRoute {
			const s = r.state ?? {};

			// User message: check time window and any active rate-limit cooldown
			if (r.reason === "user") {
				const glm = glmUsable(s);
				return {
					model: glm ? find(ctx, GLM.provider, GLM.id) : find(ctx, DS.provider, DS.id),
					state: glm
						? { glm: true, msgs: r.messages.length }
						: { msgs: r.messages.length, rlResetAt: s.rlResetAt },
				};
			}

			// Continuation: detect compaction, re-open window mid-session
			if (r.reason === "continuation" && r.previous) {
				if (compacted(r.messages, s)) {
					return {
						model: find(ctx, DS.provider, DS.id),
						state: { msgs: r.messages.length, rlResetAt: s.rlResetAt },
					};
				}
				// Currently on DeepSeek and GLM is usable again → switch to GLM.
				// This covers both the window opening mid-session and a rate-limit
				// cooldown expiring.
				if (!s.glm && glmUsable(s)) {
					return { model: find(ctx, GLM.provider, GLM.id), state: { glm: true, msgs: r.messages.length } };
				}
				return { model: r.previous.model, state: { ...s, msgs: r.messages.length } };
			}

			// Retry: on any failure, switch to DeepSeek.
			// If DeepSeek has a transient error, the next retry will also go to DeepSeek
			// and likely succeed. For GLM, even unrecognized errors trigger fallback
			// to prevent infinite retry loops on undetected error formats.
			if (r.reason === "retry" && r.failed) {
				const isDS = r.failed.model.provider === DS.provider;
				if (isDS) {
					// DeepSeek transient error → retry DeepSeek (may succeed next time).
					// Keep any pending GLM cooldown alive.
					return { model: find(ctx, DS.provider, DS.id), state: { ...s, msgs: r.messages.length } };
				}
				// GLM failure (rate-limit or unknown) → switch to DeepSeek
				// Record when to retry GLM, parsed from the 429 error message
				const rlResetAt = isRateLimit(r.failed.message.errorMessage)
					? parseRetryAfter(r.failed.message.errorMessage)
					: Date.now() + 10 * 60 * 1000; // fallback: 10 min
				return {
					model: find(ctx, DS.provider, DS.id),
					state: { msgs: r.messages.length, rlResetAt },
				};
			}

			// Direct (compaction summaries, etc.): DeepSeek
			return { model: find(ctx, DS.provider, DS.id) };
		},
	});
}
