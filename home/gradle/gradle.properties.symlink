# org.gradle.jvmargs=--illegal-access=permit
# protoc_platform=osx-x86_64

# Keep the Gradle daemon alive much longer idle. A cold daemon re-runs configuration and JIT, which
# dominates incremental build wall time; 10 minutes retired it between sessions.
# NOTE: this file is loaded AFTER the project gradle.properties, so keys set here WIN over the
# project's. Do not set org.gradle.jvmargs here either, or the project's memory settings are ignored.
org.gradle.daemon.idletimeout=10800000
