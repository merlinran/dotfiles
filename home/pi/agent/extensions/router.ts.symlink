/**
 * GLM / Qwen smart router (DeepSeek last-resort)
 *
 * Preferred primary by time of day: GLM during 00:00–14:00 UTC
 * (08:00–22:00 UTC+8); Qwen Pro (deepseek-v4.1-flash) at all other times.
 *
 * The time window shapes placement only where the prompt cache is
 * cold anyway: session start, compaction, and post-failover re-picks.
 * A running session stays on its warm model (sticky) until one of
 * those boundaries or a rate-limit, because switching mid-session at
 * a window edge would discard hundreds of K tokens of provider cache
 * per session. Fleet load converges to the window as sessions restart.
 *
 * On a rate-limit (or transient-error cooldown) of the active model,
 * fail over to the other primary. DeepSeek is used only when both
 * primaries are limited.
 *
 * Rate-limit handling matches the provider's actual behaviour
 * (Model Studio docs): TPM/RPM limits ("Allocated quota exceeded",
 * "Requests rate limit exceeded") recover within ~1 minute → short
 * cooldown + jitter. Credit/plan exhaustion (arrears, free-quota
 * stop, weekly Zai windows without a parseable reset) → long cooldown.
 * Zai "datetime" bodies and numeric Retry-After headers are honoured.
 *
 * Transient errors (connection error, timeout, abort) use a rolling
 * window instead of consecutive strikes, so interleaved successes do
 * not hide a flapping provider.
 *
 * Cooldowns are shared across sessions via ~/.pi/agent/router-limits.json
 * (override with PI_ROUTER_LIMITS_FILE), because provider limits are
 * account-scoped: one agent's 429 must cool down the model for the
 * whole fleet, including sessions started after the error.
 */

import { readFileSync, writeFileSync, renameSync, mkdirSync } from "node:fs";
import { homedir } from "node:os";
import { join, dirname } from "node:path";
import type {
	Message,
	ExtensionAPI,
	ExtensionContext,
	ModelRoute,
	ModelRouteRequest,
} from "@earendil-works/pi-coding-agent";

const GLM  = { provider: "zai" as const, id: "glm-5.3-flash" as const };
const QWEN = { provider: "qwen-pro" as const, id: "deepseek-v4.1-flash-1017" as const };
const DS   = { provider: "deepseek" as const, id: "deepseek-flash" as const };

type Which = "glm" | "qwen" | "ds";
type Primary = "glm" | "qwen";

interface State {
	/** Currently active model (sticky through continuations) */
	active?: Which;
	/** Message count for compaction detection */
	msgs?: number;
	/** Earliest time (ms) to retry GLM after rate-limit. */
	glmRlAt?: number;
	/** Earliest time (ms) to retry Qwen after rate-limit. */
	qwenRlAt?: number;
	/** Timestamps of recent transient errors per primary (rolling window). */
	glmErrAt?: number[];
	qwenErrAt?: number[];
}

// ---------------------------------------------------------------------------
// Shared, cross-session rate-limit memory
// ---------------------------------------------------------------------------

interface SharedLimits { glm?: number; qwen?: number }

const LIMITS_FILE = process.env.PI_ROUTER_LIMITS_FILE
	?? join(homedir(), ".pi", "agent", "router-limits.json");

let sharedCache: SharedLimits = {};
let sharedReadAt = 0;

function normalize(raw: unknown, now: number): SharedLimits {
	const out: SharedLimits = {};
	if (raw && typeof raw === "object") {
		const r = raw as Record<string, unknown>;
		for (const k of ["glm", "qwen"] as const) {
			const v = r[k];
			if (typeof v === "number" && Number.isFinite(v) && v > now) out[k] = v;
		}
	}
	return out;
}

/** Read shared cooldowns (cached for 15s — route() runs per request). */
function readShared(now: number): SharedLimits {
	if (sharedReadAt && now - sharedReadAt < 15_000) return sharedCache;
	try {
		sharedCache = normalize(JSON.parse(readFileSync(LIMITS_FILE, "utf8")), now);
	} catch {
		sharedCache = {};
	}
	sharedReadAt = now;
	return sharedCache;
}

/** Merge new cooldowns into the shared file (max wins, atomic replace). */
function writeShared(update: SharedLimits): void {
	if (!update.glm && !update.qwen) return;
	let merged: SharedLimits = { ...update };
	try {
		const current = normalize(JSON.parse(readFileSync(LIMITS_FILE, "utf8")), Date.now());
		merged = {
			glm: maxOf(update.glm, current.glm),
			qwen: maxOf(update.qwen, current.qwen),
		};
	} catch { /* first write or unreadable — just use the update */ }
	try {
		mkdirSync(dirname(LIMITS_FILE), { recursive: true });
		const tmp = `${LIMITS_FILE}.${process.pid}.tmp`;
		writeFileSync(tmp, JSON.stringify(merged));
		renameSync(tmp, LIMITS_FILE);
	} catch { /* best effort */ }
	sharedCache = merged;
	sharedReadAt = Date.now();
}

function maxOf(a: number | undefined, b: number | undefined): number | undefined {
	if (a === undefined) return b;
	if (b === undefined) return a;
	return Math.max(a, b);
}

// ---------------------------------------------------------------------------
// Error classification
// ---------------------------------------------------------------------------

/**
 * 00:00–14:00 UTC = 08:00–22:00 UTC+8, all days.
 * GLM is the preferred primary during this window.
 */
function glmWindow(): boolean {
	const d = new Date();
	return d.getUTCHours() >= 0 && d.getUTCHours() < 14;
}

// Rolling transient-error window
const TRANSIENT_WINDOW_MS = 90_000;   // count errors within this window
const TRANSIENT_LIMIT = 3;            // …before a short cooldown
const TRANSIENT_COOLDOWN_MS = 3 * 60_000;

// Switching primaries at a window edge discards the provider prompt
// cache. When the cached prompt is below this many tokens the switch
// is nearly free, so short/fresh sessions re-converge to the window
// immediately; larger caches stay sticky until compaction/failover.
const CACHE_SWITCH_THRESHOLD = 64_000;

// TPM/RPM cooldowns: docs say limits recover "usually within one minute".
const TPM_COOLDOWN_MS = 90_000;
const TPM_JITTER_MS = 30_000;

// Credit/plan exhaustion: won't clear on its own within minutes.
const PLAN_COOLDOWN_MS = 60 * 60_000;

function norm(err: string | undefined): string {
	return (err ?? "").toLowerCase().replace(/[\s{}"[\]\\]+/g, " ");
}

/**
 * Detect rate-limit / usage-limit / quota errors.
 * Covers common Zai / Qwen (Alibaba) / generic error formats: HTTP 429,
 * textual messages, and known numeric error codes.
 */
function isRateLimit(err: string | undefined): boolean {
	const l = norm(err);
	if (!l) return false;
	return l.includes("429") || l.includes("rate limit") || l.includes("quota")
		|| l.includes("usage limit") || l.includes("fair usage")
		|| l.includes("too many") || l.includes("rate exceeded")
		|| l.includes("throttling")
		|| l.includes("1302") || l.includes("1305") || l.includes("1308")
		|| l.includes("1310") || l.includes("1313")
		|| l.includes("20243") || l.includes("20245");
}

/**
 * Credit / plan-level exhaustion: does not clear within minutes.
 * (Free-quota stop returns 403; arrears / billing blocks are similar.)
 */
function isPlanExhausted(err: string | undefined): boolean {
	const l = norm(err);
	return l.includes("arrears") || l.includes("欠费") || l.includes("欠款")
		|| l.includes("free quota") || l.includes("免费额度")
		|| l.includes("billing") || l.includes("payment required")
		|| l.includes("403")
		// Aliyun token-plan exhaustion ("insufficient_quota", e.g. "Your
		// token-plan 1-month quota has been exhausted").
		|| l.includes("insufficient_quota") || l.includes("token-plan");
}

/**
 * Extract the rate-limit reset time from an error message.
 *
 * Zai 429s include a datetime like "2026-10-11 13:08:11" (Zai local
 * time, UTC+8). Qwen 429s may include a numeric Retry-After (seconds).
 */
function parseRetryAfter(err: string | undefined, now: number): number | undefined {
	// Retry-After seconds: "retry-after": 120 or "retry after 120 seconds"
	const secs = err?.match(/retry[- ]after\D{0,20}(\d{1,6})/i);
	if (secs) {
		const t = now + parseInt(secs[1]!, 10) * 1000;
		if (t > now && t - now < 8 * 24 * 3600 * 1000) return t;
	}
	// Aliyun token-plan reset: "reset at 11-15 16:00:00 UTC" (MM-DD, no
	// year — assume current UTC year; if that lands in the past, use next).
	const aliyun = err?.match(/\b(\d{2})-(\d{2})\s+(\d{2}:\d{2}:\d{2})\s*UTC/i);
	if (aliyun) {
		const year = new Date().getUTCFullYear();
		let t = Date.parse(`${year}-${aliyun[1]}-${aliyun[2]}T${aliyun[3]}Z`);
		if (!isNaN(t) && t <= now) t = Date.parse(`${year + 1}-${aliyun[1]}-${aliyun[2]}T${aliyun[3]}Z`);
		if (!isNaN(t) && t > now && t - now < 60 * 24 * 3600 * 1000) return t;
	}
	// Datetime: YYYY-MM-DD HH:MM:SS (space-separated, Zai local time, UTC+8)
	const match = err?.match(/(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2}:\d{2})/);
	if (match) {
		const t = Date.parse(`${match[1]}T${match[2]}+08:00`);
		// Allow up to 8 days, so weekly limits (code 1310) are honoured.
		if (!isNaN(t) && t > now && t - now < 8 * 24 * 3600 * 1000) return t;
	}
	return undefined;
}

/**
 * Cooldown for a rate-limit error, honouring explicit reset hints and
 * matching each class to how long the limit actually lasts:
 * - explicit Retry-After / Zai datetime → as given
 * - TPM/RPM ("Allocated quota exceeded", "Requests rate limit exceeded")
 *   → ~90 s + jitter (docs: recovers within about a minute)
 * - weekly Zai windows (1310/1313) without a parseable reset → 60 min
 * - credit / plan exhaustion → 60 min
 */
function rateLimitCooldownMs(err: string | undefined, now: number): number {
	const parsed = parseRetryAfter(err, now);
	if (parsed !== undefined) return parsed - now;
	const l = norm(err);
	if (isPlanExhausted(err)) return PLAN_COOLDOWN_MS;
	if (l.includes("1310") || l.includes("1313")) return PLAN_COOLDOWN_MS;
	return TPM_COOLDOWN_MS + Math.floor(Math.random() * TPM_JITTER_MS);
}

/** >50% message count drop = compaction */
function compacted(msgs: readonly Message[], s: State): boolean {
	return (s.msgs !== undefined && s.msgs >= 5 && msgs.length < s.msgs * 0.5);
}

/**
 * Absorb provider failures directly from the transcript. Some hosts
 * (Raft runtimes) never drive pi's retry flow, so the retry branch's
 * cooldown recording never runs — each failed turn just becomes a
 * terminal assistant error message and the host injects a fresh
 * "user" turn. Scanning recent messages for those errors keeps the
 * cooldown machinery working regardless of which route reason runs.
 */
function absorbTranscriptErrors(s: State, msgs: readonly Message[], now: number): State {
	let st: State = s;
	for (const m of msgs.slice(-8)) {
		const a = m as {
			role?: string; provider?: string; model?: string;
			stopReason?: string; errorMessage?: string;
		};
		if (!a || a.role !== "assistant" || !a.errorMessage) continue;
		if (a.stopReason !== "error" && a.stopReason !== "aborted") continue;
		const w = a.provider && a.model ? whichOfModel(a.provider, a.model) : undefined;
		if (w !== "glm" && w !== "qwen") continue;
		const already = st[w === "glm" ? "glmRlAt" : "qwenRlAt"];
		if (already !== undefined && already > now - PLAN_COOLDOWN_MS) continue;
		if (isRateLimit(a.errorMessage)) {
			const until = now + rateLimitCooldownMs(a.errorMessage, now);
			st = w === "glm" ? { ...st, glmRlAt: until, glmErrAt: [] } : { ...st, qwenRlAt: until, qwenErrAt: [] };
			writeShared({ [w]: until });
		}
	}
	return st;
}

// ---------------------------------------------------------------------------
// Selection
// ---------------------------------------------------------------------------

function errWindow(s: State, w: Primary): number[] {
	const arr = w === "glm" ? s.glmErrAt : s.qwenErrAt;
	return arr ?? [];
}

function withErrWindow(s: State, w: Primary, now: number): State {
	const kept = errWindow(s, w).filter((t) => now - t < TRANSIENT_WINDOW_MS);
	return w === "glm" ? { ...s, glmErrAt: kept } : { ...s, qwenErrAt: kept };
}

function clearErrWindow(s: State, w: Primary): State {
	return w === "glm"
		? (s.glmErrAt ? { ...s, glmErrAt: [] } : s)
		: (s.qwenErrAt ? { ...s, qwenErrAt: [] } : s);
}

/** Earliest retry time for a primary: max(session state, shared file). */
function rlAt(s: State, w: Primary, now: number): number | undefined {
	const own = w === "glm" ? s.glmRlAt : s.qwenRlAt;
	return maxOf(own, readShared(now)[w]);
}

function usable(s: State, w: Primary, now: number): boolean {
	const at = rlAt(s, w, now);
	return at === undefined || now >= at;
}

/**
 * Pick the model: the preferred primary for the current time window,
 * falling back to the other primary when it is cooling down, then
 * DeepSeek when both are limited.
 */
function pick(s: State, now: number): Which {
	const first: Primary = glmWindow() ? "glm" : "qwen";
	const second: Primary = first === "glm" ? "qwen" : "glm";
	if (usable(s, first, now)) return first;
	if (usable(s, second, now)) return second;
	return "ds";
}

/**
 * Sticky pick for user messages in a running session: keep the warm
 * model unless it is rate-limited (or on DeepSeek with a primary
 * recovered). Switching at a window edge would discard the provider
 * prompt cache; the window still applies at session start, compaction,
 * and failover, where the cache is cold anyway.
 *
 * Exception: when the warm model is off-window AND its cached prompt
 * is below CACHE_SWITCH_THRESHOLD tokens, switching is nearly free —
 * so short/fresh sessions converge to the window immediately instead
 * of being locked in for their whole life. Long sessions stay sticky
 * until compaction (which resets the cache anyway).
 */
function pickSticky(s: State, now: number, cacheRead?: number): Which {
	const prev = s.active;
	if (prev === "glm" || prev === "qwen") {
		if (usable(s, prev, now)) {
			const onWindow = (glmWindow() && prev === "glm") || (!glmWindow() && prev === "qwen");
			if (!onWindow && cacheRead !== undefined && cacheRead < CACHE_SWITCH_THRESHOLD) {
				return pick(s, now);
			}
			return prev;
		}
		// Warm model limited → the other primary (window decides if both free).
		const other: Primary = prev === "glm" ? "qwen" : "glm";
		if (usable(s, other, now)) return other;
		return "ds";
	}
	return pick(s, now);
}

function model(ctx: ExtensionContext, w: Which) {
	return find(ctx, w === "glm" ? GLM.provider : w === "qwen" ? QWEN.provider : DS.provider,
		w === "glm" ? GLM.id : w === "qwen" ? QWEN.id : DS.id);
}

/** Map a physical provider/model pair back to a router slot. */
function whichOfModel(provider: string, id: string): Which | undefined {
	if (provider === GLM.provider && id === GLM.id) return "glm";
	if (provider === QWEN.provider && id === QWEN.id) return "qwen";
	if (provider === DS.provider && id === DS.id) return "ds";
	return undefined;
}

/**
 * Total prompt size (tokens) of the most recent SUCCESSFUL response
 * from the active model: input + cacheWrite (freshly warmed) +
 * cacheRead (hits). Cache hits alone are NOT the cache size — a 200K
 * request with zero hits still leaves a large warm cache behind, so
 * the full prompt must count.
 *
 * Failed/aborted responses (missing or zero usage) are skipped, so a
 * zero-usage error after a large success cannot make the session look
 * small. Messages from other providers are skipped too: their usage
 * says nothing about the active model's cache.
 */
function lastPromptTokens(msgs: readonly Message[], active?: Which): number | undefined {
	for (let i = msgs.length - 1; i >= 0; i--) {
		const m = msgs[i] as {
			role?: string; provider?: string; model?: string;
			stopReason?: string; errorMessage?: string;
			usage?: { input?: number; cacheRead?: number; cacheWrite?: number; totalTokens?: number };
		} | undefined;
		if (!m || m.role !== "assistant" || !m.usage) continue;
		if (m.errorMessage || m.stopReason === "aborted" || m.stopReason === "error") continue;
		if ((m.usage.totalTokens ?? 0) <= 0) continue;
		if (active) {
			const w = m.provider && m.model ? whichOfModel(m.provider, m.model) : undefined;
			if (w !== active) continue;
		}
		const { input = 0, cacheRead = 0, cacheWrite = 0 } = m.usage;
		return input + cacheRead + cacheWrite;
	}
	return undefined;
}

/**
 * The routed slot of the latest successful response in the message
 * history. Direct requests (compaction summaries) carry no router
 * state, so the active model must be recovered from the transcript.
 */
function lastSuccessfulWhich(msgs: readonly Message[]): Which | undefined {
	for (let i = msgs.length - 1; i >= 0; i--) {
		const m = msgs[i] as {
			role?: string; provider?: string; model?: string;
			stopReason?: string; errorMessage?: string;
			usage?: { totalTokens?: number };
		} | undefined;
		if (!m || m.role !== "assistant" || !m.usage || (m.usage.totalTokens ?? 0) <= 0) continue;
		if (m.errorMessage || m.stopReason === "aborted" || m.stopReason === "error") continue;
		if (m.provider && m.model) return whichOfModel(m.provider, m.model);
	}
	return undefined;
}

function find(ctx: ExtensionContext, p: "zai" | "qwen-pro" | "deepseek", id: string) {
	const m = ctx.modelRegistry.find(p, id);
	if (!m) throw new Error(`No model: ${p}/${id}`);
	return m;
}

export default function (pi: ExtensionAPI) {
	// Register under a custom provider ID that is always available
	// (not tied to a real provider with credentials).
	pi.registerVirtualModel<State>({
		provider: "router",
		id: "auto",
		name: "GLM / Qwen Pro time-windowed router (DS only if both limited)",
		thinkingLevels: ["low", "medium", "high", "xhigh"],
		// Floor of the routed candidates: GLM/Qwen/DeepSeek are all 1M context,
		// Qwen3.8 + GLM-5.3 cap output at 131,072 (DeepSeek allows 384,000).
		contextWindow: 1_000_000,
		maxTokens: 131_072,

		route(r: ModelRouteRequest<State>, ctx: ExtensionContext): ModelRoute {
			const now = Date.now();

			// User message: check compaction FIRST (a compacted session has
			// no warm cache left → re-select by the window), then stay
			// sticky while the warm model is healthy.
			if (r.reason === "user") {
				const s = absorbTranscriptErrors(r.state ?? {}, r.messages, now);
				const wasCompacted = compacted(r.messages, s);
				if (wasCompacted || !s.active) {
					const w = pick(s, now);
					return { model: model(ctx, w), state: { ...s, active: w, msgs: r.messages.length } };
				}
				const w = pickSticky(s, now, lastPromptTokens(r.messages, s.active));
				return { model: model(ctx, w), state: { ...s, active: w, msgs: r.messages.length } };
			}

			if (r.reason === "continuation" && r.previous) {
				// Success: keep the rolling error window (it ages out after
				// TRANSIENT_WINDOW_MS) so interleaved successes cannot hide a
				// provider that is flapping.
				const s: State = { ...r.state } as State;
				const prevW = whichOfModel(r.previous.model.provider, r.previous.model.id);
				if (prevW) s.active = prevW;
				// Compaction: re-evaluate from scratch
				if (compacted(r.messages, s)) {
					const w = pick(s, now);
					return { model: model(ctx, w), state: { ...s, active: w, msgs: r.messages.length } };
				}
				// Fleet cooldowns apply mid-turn too: if the physical model this
				// continuation was using has been rate-limited by any session
				// (shared limits file), fail over instead of hammering it.
				if (prevW && !usable(s, prevW === "ds" ? "glm" : prevW, now)) {
					const w = pickSticky(s, now);
					return { model: model(ctx, w), state: { ...s, active: w, msgs: r.messages.length } };
				}
				// On DeepSeek (double-limit fallback) and a primary usable again → switch back.
				if (s.active === "ds") {
					const w = pick(s, now);
					if (w !== "ds") {
						return { model: model(ctx, w), state: { ...s, active: w, msgs: r.messages.length } };
					}
				}
				return { model: r.previous.model, state: { ...s, msgs: r.messages.length } };
			}

			// Retry: record cooldowns; re-pick.
			if (r.reason === "retry" && r.failed) {
				const fp = r.failed.model.provider;
				const errMsg = r.failed.message.errorMessage;
				let newState: State = { ...r.state, msgs: r.messages.length };
				const failedPrimary: Primary | undefined =
					fp === GLM.provider ? "glm" : fp === QWEN.provider ? "qwen" : undefined;

				if (failedPrimary && isRateLimit(errMsg)) {
					const until = now + rateLimitCooldownMs(errMsg, now);
					newState = failedPrimary === "glm"
						? { ...newState, glmRlAt: until, glmErrAt: [] }
						: { ...newState, qwenRlAt: until, qwenErrAt: [] };
					writeShared({ [failedPrimary]: until });
				} else if (failedPrimary) {
					// Transient error (connection error, timeout, abort): rolling
					// window, so interleaved successes do not hide a flapping provider.
					newState = withErrWindow(newState, failedPrimary, now);
					const hits = errWindow(newState, failedPrimary).length + 1;
					newState = failedPrimary === "glm"
						? { ...newState, glmErrAt: [...errWindow(newState, failedPrimary), now] }
						: { ...newState, qwenErrAt: [...errWindow(newState, failedPrimary), now] };
					if (hits >= TRANSIENT_LIMIT) {
						const until = now + TRANSIENT_COOLDOWN_MS;
						newState = failedPrimary === "glm"
							? { ...newState, glmRlAt: until, glmErrAt: [] }
							: { ...newState, qwenRlAt: until, qwenErrAt: [] };
						writeShared({ [failedPrimary]: until });
					}
				}

				// Sticky keeps a warm cache across transient blips: 1–2 strikes
				// retry the same (otherwise healthy) endpoint; 3 strikes within
				// TRANSIENT_WINDOW_MS trigger a cooldown above and fail over.
				// Rate-limited models already carry a cooldown, so pickSticky
				// cannot return them here.
				let w = pickSticky(newState, now);
				newState.active = w;
				return { model: model(ctx, w), state: newState };
			}

			// Direct (compaction summaries, etc.): the summary request runs
			// against the full conversation BEFORE compaction discards it, so
			// it can still hit the active provider's warm cache. Direct
			// requests carry no router state, so recover the active slot from
			// r.previous or the latest successful response in the transcript.
			const directActive = r.state?.active
				?? (r.previous ? whichOfModel(r.previous.model.provider, r.previous.model.id) : undefined)
				?? lastSuccessfulWhich(r.messages);
			const w = pickSticky({ ...(r.state ?? {}), active: directActive }, now);
			return { model: model(ctx, w), state: { ...(r.state ?? {}), active: w } };
		},
	});
}
