#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.

set -e

parentDirectory="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P)"
dotfilesDirectory="$(cd "$( dirname "$parentDirectory" )" && pwd -P)"

displayUsageAndExit() {
	echo "dot -- dotfiles management"
	echo ""
	echo "Usage: dot [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -h, --help    Show this help message and exit"
	exit
}

while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-e"|"--edit")
			exec "$EDITOR" "$dotfilesDirectory"
			exit
			;;
		*)
			echo "Invalid option: $1"
			displayUsageAndExit
			;;
	esac
	shift
done

export ZSH=$HOME/.dotfiles

# Update dotfiles themselves. Skipped when script/bootstrap already did it --
# pulling here would rewrite that still-running script mid-execution. Bare
# `git pull` is refused anyway because gitconfig sets pull.rebase=true whenever
# the tree is dirty, and the old `git pull || true` hid that behind a cheerful
# "git pull" line.
if [ -z "${DOTFILES_SELF_UPDATED:-}" ]
then
	echo "› git pull"
	if ! git -C "$ZSH" fetch --quiet
	then
		echo "  git fetch failed (offline, or no remote); continuing"
	elif ! git -C "$ZSH" merge --ff-only '@{u}' >/dev/null 2>&1
	then
		echo "  could not fast-forward (local changes or diverged history); run 'git pull' in $ZSH"
	fi
fi

# Set macOS defaults
$ZSH/macos/set-defaults.sh

# Set macOS hostname
$ZSH/macos/set-hostname.sh

# Install homebrew
$ZSH/homebrew/install.sh 2>&1

# A brew that was installed just now is not on this shell's PATH yet: homebrew
# lives in /opt/homebrew on Apple Silicon and /usr/local on Intel.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

# Upgrade homebrew
echo "› brew update"
brew update

echo "› brew upgrade"
brew upgrade

# Install software
echo "› script/install"
$ZSH/script/install
