#!/bin/zsh
# pi with Cursor Pro subscription models
#
# Default model: auto (Cursor auto-routing).
# Ctrl+P cycles only the curated list passed to --models; edit to taste.
# Note: the full model picker (/model, ctrl+l) still lists every Cursor model.
/opt/homebrew/bin/pi \
  --provider cursor \
  --model auto \
  --models "cursor/auto,cursor/composer-2.5,cursor/claude-opus-5,cursor/claude-fable-5,cursor/cursor-grok-4.5,cursor/cursor-grok-4.6" \
  "$@"
